{
  "name": "hiringbull-server",
  "version": "1.1.0",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "bun run build && nodemon --watch src --exec node dist/index.js",
    "build": "prisma generate && tsc",
    "lint": "eslint .",
    "tsc": "tsc --noemit",
    "prisma:generate": "prisma generate"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "expo-server-sdk": "^4.0.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "helmet": "^6.2.0",
    "http-status": "^2.1.0",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "razorpay": "^2.9.6",
    "resend": "^6.12.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "xss": "^1.0.15"
